# =============================================================================
# The Coast — Local Environment Template
# =============================================================================
# Copy to .env and fill in real values. .env is gitignored.
# Never commit secrets. Production values live in Vercel project settings.
# =============================================================================

# --- App ---
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Payload CMS ---
# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=replace-me-with-a-strong-random-string

# --- Database (Turso / libSQL) ---
# Format: libsql://<db-name>-<org>.turso.io
# Local dev can use file:./local.db if you don't want a hosted instance.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# --- Email (Resend) ---
RESEND_API_KEY=
# Sender address shown to recipients. Must be a verified Resend domain.
RESEND_FROM=dev@admin.coastglobal.org

# --- Media (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Google Reviews (Featurable widget proxy) ---
# Place ID for "Leave a review" deeplink and AggregateRating schema.
GOOGLE_PLACE_ID=ChIJ_fjV-mLpAo4Riif8WzjsV70

# --- Calendly ---
# Public — exposed to the client to render Book-a-Call embeds and popups.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/davidcoast-coastglobal/30min

# --- Gallery subdomain (gallery.coastglobal.org) ---
# Optional fallbacks for the Pinterest + Shopify links. Preferred source is the
# admin: Globals -> Gallery Settings. These only apply if that global is blank.
NEXT_PUBLIC_GALLERY_PINTEREST_URL=https://pin.it/nW5MRvKEz
NEXT_PUBLIC_GALLERY_SHOPIFY_URL=

# --- Gallery auto-sync from Google Drive (daily Vercel Cron) ---
# Protects /api/sync-gallery-from-drive; Vercel auto-sends it as a Bearer token.
CRON_SECRET=replace-me-with-a-strong-random-string
# The Drive folder to sync (id from the folder URL).
GOOGLE_DRIVE_FOLDER_ID=1TneZolVQ9yKxTYP8i5hWSNAZ_4V9D1vm
# Service-account key JSON (raw JSON or base64). Share the folder with this
# account's email (Viewer). Drive API must be enabled on the GCP project.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional: category assigned to imported images (artwork|illustration|photography|brand|product|other).
GALLERY_DRIVE_CATEGORY=artwork
